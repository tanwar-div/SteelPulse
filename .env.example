# Core services
DATABASE_URL=postgresql+psycopg://steelpulse:steelpulse@localhost:5432/steelpulse
DATABASE_FALLBACK_URL=sqlite+pysqlite:///./steelpulse.db
REDIS_URL=redis://localhost:6379/0
STEELPULSE_ENV=local

# RBAC: key:username:role, comma separated
STEELPULSE_API_KEYS=gateway-key:edge.gateway:system,operator-key:line.operator:operator,tech-key:maint.tech:technician,planner-key:supply.planner:planner,supervisor-key:plant.supervisor:supervisor

# Event bus and worker pool
TELEMETRY_STREAM=steelpulse.telemetry
CONSUMER_GROUP=detectors
WORKER_COUNT=4
BATCH_SIZE=256
BLOCK_MS=50
STREAM_MAXLEN=1000000

# Delivery guarantees
MAX_DELIVERY_ATTEMPTS=5
STALE_CLAIM_MS=30000
RETRY_BASE_DELAY=0.05

# Anomaly detection
FLATLINE_SAMPLES=12
ALERT_SUPPRESSION_SECONDS=300
HEARTBEAT_TIMEOUT_SECONDS=120

# Maintenance and inventory
AUTO_WORK_ORDER_SEVERITIES=critical,high
AUTO_REPLENISH=true

# SLA budgets
SLA_MINUTES_ACK_CRITICAL=15
SLA_MINUTES_ACK_HIGH=60
SLA_MINUTES_ACK_MEDIUM=240
SLA_HOURS_WO_CRITICAL=8
SLA_HOURS_WO_HIGH=24
SLA_HOURS_WO_NORMAL=72
